# =============================================================================
# STRATUM.ai — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env.local   (Windows: copy .env.example .env.local)
# 2. Fill in real values below. Never commit .env.local (it is gitignored).
# 3. Minimum to run locally: DATABASE_URL, DIRECT_URL, AUTH_SECRET, OPENAI_API_KEY, NEXTAUTH_URL
# =============================================================================

# --- Site URL (origin only, no path) ---
# Must match the URL you open in the browser (OAuth redirect URIs depend on this).
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000

# --- Auth secret (required in production) ---
# Generate: openssl rand -base64 32
# Use AUTH_SECRET only — do not set both AUTH_SECRET and NEXTAUTH_SECRET to different values.
AUTH_SECRET=

# Google sign-in (optional) — register redirect URIs in Google Cloud Console → Credentials → OAuth client:
#   Local:  http://127.0.0.1:3000/api/auth/callback/google
#   Prod:   https://stratumielts.com/api/auth/callback/google
# Production also set: NEXTAUTH_URL=https://stratumielts.com  NEXT_PUBLIC_APP_URL=https://stratumielts.com
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Database (PostgreSQL / Supabase) ---
# Runtime app: Supabase **Transaction** pooler (port 6543), add ?pgbouncer=true if needed.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma migrate / db push: **Session** pooler (5432) or direct connection string.
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- OpenAI (essay check, Task 1/2 generation) ---
OPENAI_API_KEY=sk-your-key-here
# Required when using project-scoped keys (sk-proj-...). Must match the key's project — omit if unsure.
# OPENAI_PROJECT_ID=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# TTS: prefer tts-1 if your OpenAI project has limited model access.
# App also falls back: OPENAI_TTS_MODEL → tts-1 → gpt-4o-mini-tts → tts-1-hd
# OPENAI_TTS_MODEL=tts-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Replicate (optional; Neural Sync demo + TTS karaoke word sync via WhisperX) ---
# IELTS Listening-style British lecturer voice (default English_Wiselady).
# Alternatives: English_Deep-VoicedGentleman, English_WiseScholar, English_Steadymentor
# REPLICATE_TTS_VOICE=English_Wiselady
# REPLICATE_TTS_SPEED=0.94

# https://replicate.com/account/api-tokens
# Used by: npm run demo:neural-sync-audio, and /api/tts (analysis / archive shadowing)
# Align only (reuse existing demo mp3): node scripts/generate-neural-sync-audio.mjs --align-only
# REPLICATE_API_TOKEN=r8_...

# --- Cron: practice email reminders (/api/cron/practice-reminders) ---
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Keep-warm (reduce Vercel cold starts on Hobby) ---
# Hobby allows only ~1 Vercel cron/day. Ping every 10 min via cron-job.org (free):
#   GET https://stratumielts.com/api/warm
#   Header: Authorization: Bearer <CRON_SECRET>  (or set WARM_SECRET)
# WARM_SECRET=

# --- Telegram bot — 2× daily group posts + /start /tip commands ---
# TELEGRAM_BOT_TOKEN=
# Canonical @username for channel "Check my text" buttons (default: Stratum_ielts_writing_bot)
# TELEGRAM_BOT_USERNAME=Stratum_ielts_writing_bot
# Group chat id (add bot to group as admin). Also accepts TELEGRAM_CHANNEL_ID.
# TELEGRAM_GROUP_ID=-1001234567890
# Optional webhook hardening:
# TELEGRAM_WEBHOOK_SECRET=
# After deploy: node --env-file=.env.local scripts/telegram-set-webhook.js
# Optional: gpt-4o-mini (default) for morning/evening posts when OPENAI_API_KEY is set
# TELEGRAM_OPENAI_MODEL=gpt-4o-mini
# Set TELEGRAM_USE_AI=0 to force static templates only
# Deep essay check in DMs uses the same pipeline as the web app (gpt-4o, 2-phase). Set TELEGRAM_DEEP_CHECK=0 for fast shallow mode.
# Private Telegram user id for ops alerts (message the bot /start, then scripts/telegram-get-alert-chat-id.js)
# TELEGRAM_ALERT_CHAT_ID=123456789
# Manual post test:
# curl -H "Authorization: Bearer $CRON_SECRET" "https://YOUR_DOMAIN/api/cron/telegram-daily?slot=morning"

# --- Facebook cross-posting (optional, runs after Telegram send when FACEBOOK_USE_AI=1) ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=          # Meta App → Settings → Basic (required for ~60-day tokens)
# FACEBOOK_PAGE_ID=
# FACEBOOK_ACCESS_TOKEN=          # Page token from scripts/facebook-get-page-token.js
# FACEBOOK_USER_ACCESS_TOKEN=     # Long-lived User token from facebook-get-page-token.js
# FACEBOOK_USE_AI=1
# OPENAI_IMAGE_MODEL=gpt-image-1
# Setup: node --env-file=.env.local scripts/facebook-get-page-token.js
# Test:  node --env-file=.env.local scripts/facebook-verify-token.js
# IELTS Writing post (Facebook only, no Telegram):
# curl -H "Authorization: Bearer $CRON_SECRET" "https://YOUR_DOMAIN/api/cron/facebook-post?variant=1"

# --- SMTP for reminder emails (optional locally; required on prod if cron is enabled) ---
EMAIL_USER=
EMAIL_PASS=

# --- Resend (deposit “I paid” admin alerts + credit confirmation to users) ---
# https://resend.com/api-keys — verify a domain, then set RESEND_FROM to that domain.
# Until a domain is verified, onboarding@resend.dev can only email the Resend
# account owner; the app retries to that owner and falls back to EMAIL_USER SMTP.
RESEND_API_KEY=
RESEND_FROM=STRATUM.ai <noreply@yourdomain.com>

# --- Manual Visa / card top-up (shown in CreditsTopUpModal) ---
# NEXT_PUBLIC_* copies are required so the client modal can show the number.
PAYMENT_CARD_LABEL=Visa
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_TRANSFER_NOTE=STRATUM + your login email
NEXT_PUBLIC_PAYMENT_CARD_LABEL=Visa
NEXT_PUBLIC_PAYMENT_CARD_NUMBER=
NEXT_PUBLIC_PAYMENT_CARD_HOLDER=
NEXT_PUBLIC_PAYMENT_TRANSFER_NOTE=STRATUM + your login email
# PAYMENT_EXTRA_INSTRUCTIONS=USD preferred; send exact pack amount.

# --- Admin API (/api/admin/*) — comma-separated allowed emails ---
ADMIN_EMAILS=admin@example.com

# --- Optional ---
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Extra next/image hosts only (sample charts already allowlisted in src/lib/allowedImageHosts.js).
# Placeholders like cdn.example.com do nothing unless you host images there.
# IMAGE_ALLOWED_HOSTS=

# --- Playwright E2E (see .env.e2e.example) ---
# E2E_MOCK_OPENAI=1  # mocks essay check only; Task 1 chart vision still uses OpenAI
# E2E_TEST_EMAIL=e2e@example.com
# E2E_TEST_PASSWORD=
