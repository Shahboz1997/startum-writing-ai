generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  credits       Int       @default(3)   // New users: free checks; decremented per check
  language      String?   @default("en") // en | ru | uz
  /// Email practice reminders (cron + /settings)
  practiceRemindersEnabled Boolean  @default(false)
  practiceReminderHour     Int      @default(19) // 0–23 local
  practiceReminderMinute   Int      @default(0)  // 0–59 local
  practiceReminderTimezone String   @default("UTC") // IANA, e.g. Europe/Moscow
  /// Comma-separated JS weekday numbers 0=Sun … 6=Sat (e.g. "1,2,3,4,5" Mon–Fri)
  practiceReminderDays     String   @default("1,2,3,4,5")
  practiceReminderLastSent DateTime?
  accounts          Account[]
  sessions          Session[]
  checks            Check[]
  wordListItems     WordListItem[]
  favoriteTemplates FavoriteTemplate[]
  depositRequests   DepositRequest[]
}

/// Manual top-up claims + Lemon Squeezy purchases. Credits applied when status = credited.
model DepositRequest {
  id          String    @id @default(cuid())
  userId      String
  userEmail   String
  packId      String
  packName    String
  credits     Int
  amountUsd   Float
  currency    String    @default("USD")
  /// pending | paid_claimed | credited | rejected
  status      String    @default("paid_claimed")
  note        String?   @db.Text
  adminNote   String?   @db.Text
  /// Lemon Squeezy order id — unique for webhook idempotency
  lemonOrderId String?  @unique
  notifySentAt DateTime?
  creditedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([userEmail])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Check {
  id         String   @id @default(cuid())
  type       String   @default("TASK_2") // 'TASK_1' | 'TASK_2'
  content    String   @db.Text
  promptText String?  @db.Text
  score      Float?
  feedback   Json?    // Examiner payload: criteria, errors/subtopics, suggested_rewrite, etc.
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([feedback(ops: JsonbPathOps)], type: Gin, map: "Check_feedback_gin_idx")
}

/// Guest essay checks consumed per IP (hashed) before registration.
model GuestCheckQuota {
  ipHash    String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-user vocabulary saved from corrections / lexical upgrades (synced across devices).
model WordListItem {
  id       String   @id @default(cuid())
  userId   String
  wordKey  String
  word     String
  taskType String?
  source   String?
  note     String?
  synonyms Json     @default("[]")
  addedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordKey])
  @@index([userId, addedAt(sort: Desc)])
}

/// Favourite writing-bank template IDs (from data/templates.json).
model FavoriteTemplate {
  userId     String
  templateId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
}

/// Fixed-window API rate limits (userId or IP scope + route).
model AiRateLimitBucket {
  bucketKey   String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

